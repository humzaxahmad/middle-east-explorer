---
// The shell shared by the content pages: the <head>, the navigation and the
// page width. <slot /> is where each page's own content gets inserted.
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} | Middle East Explorer</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-name" href="/">Middle East Explorer</a>
      <nav>
        <a href="/">Globe</a>
        <a href="/sectors">Sectors</a>
        <a href="/diversification">Diversification</a>
        <a href="/browse">Browse</a>
        <a href="/about">About</a>
      </nav>
    </header>
    <main class="page">
      <slot />
    </main>
  </body>
</html>
