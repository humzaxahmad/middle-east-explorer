---
// The full-screen globe area, plus a fallback message and the page's data.
import { getCollection } from 'astro:content';
import InfoPanel from './InfoPanel.astro';
import { TODO, findCountry } from '../data/countries';
import { INDICATORS, exposureHeader, indicatorsFor, shortIndicator } from '../data/indicators';

// Runs at build time. Gathers just what the panel needs from the Markdown files,
// so the browser doesn't have to download whole profiles.
const countries = await getCollection('countries');
const chokepoints = await getCollection('chokepoints');
const chains = await getCollection('chains');
const flows = await getCollection('flows');

// "1.57 million barrels a day (2024)", or the bare TODO text if the volume
// hasn't been sourced yet, same convention as every other indicator field.
function formatVolume(volume: (typeof flows)[number]['data']['volume'], unit: string) {
  if (typeof volume === 'string') return volume;
  const number = 'low' in volume ? `${volume.low} to ${volume.high}` : volume.value.toLocaleString('en-US');
  return `${number} ${unit} (${volume.year})`;
}
const panelData = {
  countries: countries.map(({ data }) => ({
    code: data.iso3,
    summary: data.summary,
    header: exposureHeader(data.exposureType, data.protectionStatus, TODO),
    // Raw values for the globe's colouring, separate from the formatted header
    // text above. "exporter", "importer", "mixed" or TODO if not set yet.
    exposureType: data.exposureType,
    protectionStatus: data.protectionStatus,
    // Only the headline indicators for this country's exposure type, already
    // turned into short text like "54.6% (2025)".
    indicators: indicatorsFor(data.exposureType).map((key) => ({
      label: INDICATORS[key].label,
      value: shortIndicator(key, data[key]),
    })),
    hittingNow: data.hittingNow,
    // The button text comes from the chokepoint that shares this chain's slug,
    // such as "See the Strait of Hormuz shock". The link only appears once the
    // chain file itself exists; until then the button says "coming soon".
    chain: data.relatedChainSlug
      ? {
          text: `See the ${chokepoints.find((c) => c.data.relatedChainSlug === data.relatedChainSlug)?.data.name ?? 'related'} shock`,
          href: chains.some((c) => c.id === data.relatedChainSlug) ? `/chains/${data.relatedChainSlug}` : undefined,
        }
      : undefined,
  })),
  // Pins for the globe. Each one gets a "See the X shock" button, same as a
  // country's panel, pointing at the chain that shares its relatedChainSlug.
  // "play" is only present once that chain file actually exists: it drives
  // "play the shock" (src/scripts/globe.ts), stepping through the chain's
  // stages while the pin pulses, matching flow arcs turn red, and the
  // countries that chain names as exposed/protected light up.
  chokepoints: chokepoints.map(({ id, data }) => {
    const chain = chains.find((c) => c.id === data.relatedChainSlug);
    return {
      id,
      name: data.name,
      lat: data.lat,
      lng: data.lng,
      status: data.status,
      statusText: `${data.status.charAt(0).toUpperCase()}${data.status.slice(1)} since ${data.statusAsOf.toLocaleDateString('en-GB', { dateStyle: 'long', timeZone: 'UTC' })}`,
      chain: {
        text: `See the ${data.name} shock`,
        href: chain ? `/chains/${data.relatedChainSlug}` : undefined,
      },
      play: chain
        ? {
            stages: [
              { label: 'Trigger', text: chain.data.trigger },
              { label: 'Energy hit', text: chain.data.energyHit },
              { label: 'Economy hit', text: chain.data.economyHit },
              {
                label: 'Sectors',
                text: `Usually gain: ${chain.data.sectorsWinners.join('; ')}. Usually lose: ${chain.data.sectorsLosers.join('; ')}.`,
              },
              {
                label: 'Countries',
                text: `Exposed: ${chain.data.countriesExposed.map((c) => findCountry(c)?.name ?? c).join(', ')}. Protected: ${
                  chain.data.countriesProtected.length
                    ? chain.data.countriesProtected.map((c) => findCountry(c)?.name ?? c).join(', ')
                    : 'none'
                }.`,
              },
              { label: 'What to watch', text: chain.data.whatToWatch },
            ],
            exposedCodes: chain.data.countriesExposed,
            protectedCodes: chain.data.countriesProtected,
          }
        : undefined,
    };
  }),
  // Energy flow arcs: who supplies whom. Unknown codes are skipped rather
  // than crashing the build, the same pattern as the chain page's country list.
  flows: flows
    .map(({ data }) => {
      const from = findCountry(data.from);
      const to = findCountry(data.to);
      if (!from || !to) return undefined;
      return {
        fromName: from.name,
        toName: to.name,
        fromLat: from.lat,
        fromLng: from.lng,
        toLat: to.lat,
        toLng: to.lng,
        type: data.type,
        volumeText: formatVolume(data.volume, data.unit),
        explainer: data.explainer,
        viaChokepoint: data.viaChokepoint,
      };
    })
    .filter((flow) => flow !== undefined),
};

// The "<" replacement stops any text in the data from closing the script tag early.
const panelJson = JSON.stringify(panelData).replace(/</g, '\\u003c');
---
<div id="globe"></div>
<InfoPanel />

<!-- Shown while the globe's code downloads, which can take a moment on a phone. -->
<p id="globe-loading" class="globe-message">Loading the globe…</p>
<p id="globe-message" class="globe-message" hidden>
  The globe couldn't load. Your browser may not support 3D graphics, or the map data may have failed to download. Try refreshing the page, or <a href="/browse">browse all pages</a> instead.
</p>
<noscript>
  <style>#globe-loading { display: none; }</style>
  <p class="globe-message">The globe needs JavaScript. You can still <a href="/browse">browse all pages</a>.</p>
</noscript>

<!-- The data is stored in the page as JSON, for globe.ts to read in the browser. -->
<script id="panel-data" type="application/json" set:html={panelJson}></script>

<script>
  // Astro bundles this import and runs it in the browser.
  import '../scripts/globe';
</script>
